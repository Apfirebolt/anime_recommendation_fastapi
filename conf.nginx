server {
    listen 80;
    server_name recommendation.softgenie.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name recommendation.softgenie.org;

    ssl_certificate /etc/letsencrypt/live/recommendation.softgenie.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/recommendation.softgenie.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:8002; # Update this to your FastAPI app's port
        proxy_http_version 1.1;

        # Standard proxy headers & WebSockets support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $http_host;
        proxy_cache_bypass $http_upgrade;

        # Real IP tracking
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}